# Auto A11y Python Configuration
# Copy this file to .env and update with your values

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
HOST=127.0.0.1
PORT=5001

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
DATABASE_NAME=auto_a11y

# Claude AI Configuration
# Get your API key from https://console.anthropic.com/
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-3-opus-20240229
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=1.0

# Browser Configuration
# BROWSER_MODE: "local" (run Chromium here), "remote" (defer to worker), "disabled" (no tests)
BROWSER_MODE=local
BROWSER_HEADLESS=True
# Pause N seconds at the start of discovery/testing so you can sign in manually in the
# visible browser window. 0 disables. When > 0, browser headless mode is forced OFF.
INTERACTIVE_AUTH_DELAY_SECONDS=0
BROWSER_TIMEOUT=30000
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080

# Scraping Configuration
MAX_PAGES_PER_SITE=500
MAX_CRAWL_DEPTH=3
REQUEST_DELAY=1.0
USER_AGENT=Auto-A11y/1.0 Accessibility Scanner
RESPECT_ROBOTS_TXT=True

# Testing Configuration
PARALLEL_TESTS=5
TEST_TIMEOUT=60000
RUN_AI_ANALYSIS=True

# SMTP email (optional -- leave blank to disable password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CNIB Access Labs | AutoA11y

# Microsoft 365 SSO (optional -- leave blank to disable)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Google SSO (optional -- leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Drupal Sync (optional -- leave blank to disable)
DRUPAL_BASE_URL=
DRUPAL_USERNAME=
DRUPAL_PASSWORD=
DRUPAL_EXPORT_ENABLED=true

# Recordings / AudioA11y (video & audio audits)
# DEEPGRAM_API_KEY: required to transcribe uploaded recordings.
DEEPGRAM_API_KEY=
# HF_TOKEN: HuggingFace token used for cross-segment speaker remapping
# (pyannote.audio). OPTIONAL -- if blank, recordings still process but
# every speaker keeps its per-segment label instead of a globally
# consistent one. To enable remapping you MUST:
#   1. Create a token at https://huggingface.co/settings/tokens
#   2. Accept the model terms at https://huggingface.co/pyannote/embedding
#      (the model is gated; an un-accepted token gets a 401 and the
#      pipeline falls back to no-remap)
HF_TOKEN=