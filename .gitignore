# Python
__pycache__/
*.py[cod]

# Build-time commit stamp (written into the staged app by build/*.sh;
# never belongs in the repo — build_info.py falls back to git in dev).
auto_a11y/BUILD_COMMIT
*$py.class
*.so
.Python
build/*
!build/*.sh
!build/README.md
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/
.venv

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Testing
.coverage
.pytest_cache/
htmlcov/
.tox/
.coverage.*
*.cover
.hypothesis/

# Type checker caches
.mypy_cache/
.pyright/
# ty currently has no on-disk cache at the pinned version

# Database
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# Environment variables
.env
.env.local
.env.*.local

# Application specific
screenshots/
reports/
output/
temp/
data/
*.xlsx
*.json
!package.json
!requirements.json
!auto_a11y/web/translations/inline_issue_ids.json
!tests/audio/snapshots/prompts.json

# Secrets - NEVER commit these
*.key
*.pem
*.cert
config/secrets.yaml
config/secrets.json

# Chrome/Puppeteer user data
user_data/
chrome_data/

# MongoDB
dump/
mongodump/

# AI Debug files
ai_debug/
ai_response_*.txt

# Test scripts (not part of main codebase)
test_*.py
# But include production files in auto_a11y that happen to start with test_
!auto_a11y/config/test_*.py
!auto_a11y/core/test_*.py
!auto_a11y/models/test_*.py
!auto_a11y/testing/test_*.py
!auto_a11y/testing/touchpoint_tests/test_*.py
!auto_a11y/web/api/schemas/test_*.py
!tests/test_*.py
!tests/core/test_*.py
!tests/pdf/test_*.py
!tests/api/test_*.py
!tests/api/schemas/test_*.py
!tests/api/openapi/test_*.py
!tests/audio/test_*.py
!tests/web/test_*.py
verify_*.py
adapt_*.py

# Video/audio files from ticketA11y
ticketA11y/

# audioA11y test fixtures (downloaded on demand by scripts/fetch_audio_fixtures.py)
tests/audio/fixtures/*.mp4

# Large binary files - never commit these
*.mp4
*.png
# Documentation images are tracked despite the blanket *.png rule
!docs/images/**
*.pptx
*.mov
*.avi
*.mkv

# ...except bundled package assets that the app needs at runtime (e.g. the
# CNIB AccessLabs logo rendered onto recording title cards / watermark).
# These ship inside the macOS app bundle via the source rsync, so they
# MUST be committed.
!auto_a11y/audio/assets/
!auto_a11y/audio/assets/*.png

# Documentation drafts
*_COMPLETE.md
*_SUMMARY.md
*_MIGRATION.md
!docs/*.md
# Generated report directories
*_Deduplicated_*/
*.docx
# Curated documentation exports are tracked despite the blanket *.docx rule
!docs/Auto_A11y_API_Guide.docx
!docs/Auto_A11y_User_Guide.docx
!docs/templates/reference.docx
~$*
.superpowers/
